// EEPROM Helpers
void saveLayoutToEEPROM() {
  EEPROM.write(EEPROM_LAYOUT_FLAG, 1);
  for (int i = 0; i < 18; i++) {
    EEPROM.write(EEPROM_LAYOUT_ADDR + i, homeLayout[i]);
  }
}

void loadLayoutFromEEPROM() {
  if (EEPROM.read(EEPROM_LAYOUT_FLAG) == 1) {
    for (int i = 0; i < 18; i++) {
      homeLayout[i] = EEPROM.read(EEPROM_LAYOUT_ADDR + i);
    }
  } else {
    saveLayoutToEEPROM();
  }
}

void saveNoteToEEPROM(String note) {
  EEPROM.write(EEPROM_NOTES_FLAG, 1);
  int len = note.length();
  if (len > 99) len = 99;
  for (int i = 0; i < len; i++) {
    EEPROM.write(EEPROM_NOTES_ADDR + i, note[i]);
  }
  EEPROM.write(EEPROM_NOTES_ADDR + len, 0);
}

void loadNoteFromEEPROM() {
  if (EEPROM.read(EEPROM_NOTES_FLAG) == 1) {
    userNote = "";
    for (int i = 0; i < 99; i++) {
      char c = EEPROM.read(EEPROM_NOTES_ADDR + i);
      if (c == 0) break;
      userNote += c;
    }
  }
}

void savePINToEEPROM(String pin) {
  EEPROM.write(EEPROM_PIN_FLAG, 1);
  for (int i = 0; i < 4; i++) EEPROM.write(EEPROM_PIN_ADDR + i, i < pin.length() ? pin[i] : '0');
}

bool loadPINFromEEPROM(String &pin) {
  if (EEPROM.read(EEPROM_PIN_FLAG) != 1) return false;
  pin = "";
  for (int i = 0; i < 4; i++) pin += (char)EEPROM.read(EEPROM_PIN_ADDR + i);
  return true;
}

