        else if (x >= 225 && x <= 265) flashlightMode = 3;
        else if (x >= 270 && x <= 305) { currentMode = 0; drawHomeScreen(); delay(200); return; }
        drawFlashlightUI(); delay(150);
      }
    }
    else if (currentMode == 27) { // Dice & RNG App
      if (y >= 45 && y <= 77) {
        if (x >= 15 && x <= 80) { rngMin = 1; rngMax = 6; lastRngResult = 0; drawDiceRNGUI(); delay(150); }
        else if (x >= 85 && x <= 150) { rngMin = 1; rngMax = 20; lastRngResult = 0; drawDiceRNGUI(); delay(150); }
        else if (x >= 155 && x <= 230) { rngMin = 1; rngMax = 2; lastRngResult = 0; drawDiceRNGUI(); delay(150); }
        else if (x >= 235 && x <= 305) { rngMin = 1; rngMax = 100; lastRngResult = 0; drawDiceRNGUI(); delay(150); }
      } else if (y >= 180 && y <= 228) { rollDiceRNG(); delay(200); }
    }
  } else { lastX = -1; lastY = -1; }
}
