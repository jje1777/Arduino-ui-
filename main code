void updateDinoPhysics() {
  if (currentMode != 16 || dinoGameOver) return;
  unsigned long now = millis();
  if (now - lastDinoFrame < 30) return;
  lastDinoFrame = now;

  if (isJumping) {
    dinoY += dinoVelocity; dinoVelocity += 2;
    if (dinoY >= 160) { dinoY = 160; isJumping = false; dinoVelocity = 0; }
  }
  cactusX -= 7;
  if (cactusX < -15) { cactusX = 320; dinoScore += 10; playTone(1200, 20); if (dinoScore > dinoHighScore) dinoHighScore = dinoScore; }
  if (cactusX >= 30 && cactusX <= 60 && dinoY >= 140) { dinoGameOver = true; playTone(300, 400); }
  drawDinoUI();
}

