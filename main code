// --- SETUP & MAIN LOOP ---
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(TFT_BACKLIGHT_PIN, OUTPUT);
  analogWrite(TFT_BACKLIGHT_PIN, screenBrightness);

  Modulino.begin(Wire1);
  buzzer.begin();

  uint8_t savedVol = EEPROM.read(EEPROM_VOL_ADDR);
  if (savedVol <= 100) systemVolume = savedVol;

  uint8_t savedBright = EEPROM.read(EEPROM_BRIGHT_ADDR);
  if (savedBright > 0) { screenBrightness = savedBright; analogWrite(TFT_BACKLIGHT_PIN, screenBrightness); }

  uint8_t savedTheme = EEPROM.read(EEPROM_THEME_ADDR);
  if (savedTheme > 5) savedTheme = 0;
  applyTheme(savedTheme);

  loadLayoutFromEEPROM();
  loadNoteFromEEPROM();

  String epin; if (loadPINFromEEPROM(epin)) savedPIN = epin;

  gfx->begin();

  randomSeed(analogRead(A0) + millis());
  lastActivityTime = millis();
  drawHomeScreen();
}

void loop() {
  unsigned long now = millis();

  // Timer Tick Physics
  if (timerRunning && timerSubTab == 0) {
    if (now - previousMillis >= 1000) {
      previousMillis = now;
      if (totalSeconds > 0) { totalSeconds--; renderTimerText(); }
      else {
        timerRunning = false; playTone(2000, 800);
        if (currentMode == 2) drawTimerUI();
      }
    }
  }

  // Stopwatch Tick Physics
  if (swRunning && timerSubTab == 1) {
    swElapsed = now - swStartTime;
    if (currentMode == 2) renderTimerText();
  }

  // SOS Strobe Physics
  if (currentMode == 26 && flashlightMode == 3) {
    if (now - lastSosToggle > 250) {
      lastSosToggle = now;
      sosState = !sosState;
      drawFlashlightUI();
    }
  }

  updateDinoPhysics();

  TSPoint p = ts.getPoint();
  pinMode(XM, OUTPUT); pinMode(YP, OUTPUT);

  bool hasTouch = (p.z > MINPRESSURE && p.z < MAXPRESSURE) || remoteTouchPending;
  int16_t x = 0, y = 0;

  if (hasTouch) {
    lastActivityTime = millis();
    playTone(1000, 15);

    if (remoteTouchPending) { x = remoteTouchX; y = remoteTouchY; remoteTouchPending = false; }
    else { x = map(p.y, TS_MINY, TS_MAXX, 0, gfx->width()); y = map(p.x, TS_MINX, TS_MAXY, 0, gfx->height()); }

    // UNIVERSAL HOME BUTTON CHECK
    if (currentMode != 0 && currentMode != 9 && currentMode != 10 && currentMode != 13 && currentMode != 26 && x >= 268 && y <= 38) {
      currentMode = 0; drawHomeScreen(); delay(200); return;
    }

    // UNIVERSAL BACK BUTTON CHECK
    if (x <= 48 && y <= 38 && currentMode != 26) {
      if (currentMode == 5 || currentMode == 6 || currentMode == 11 || currentMode == 12 || currentMode == 19 || currentMode == 22) {
        currentMode = 4; drawSettingsUI(); delay(200); return;
      } else if (currentMode == 8) {
        if (keyboardReturnMode == 17) { currentMode = 17; drawDiscordUI(); }
        else if (keyboardReturnMode == 18) { currentMode = 18; drawNotesUI(); }
        delay(200); return;
      } else if (currentMode == 15 || currentMode == 16) {
        currentMode = 14; drawGamesMenuUI(); delay(200); return;
      } else if (currentMode != 0 && currentMode != 9 && currentMode != 10 && currentMode != 13) {
        currentMode = 0; drawHomeScreen(); delay(200); return;
      }
    }

    // Dynamic Touch Routing
    if (currentMode == 0) {
      if (x >= 200 && y <= 42) { currentMode = 6; drawWiFiStatusUI(); delay(200); return; }

      if (y >= 12 && y <= 42) {
        if (x >= 108 && x <= 138 && homePage > 0) { homePage--; drawHomeScreen(); delay(200); return; }
        else if (x >= 165 && x <= 195 && homePage < 2) { homePage++; drawHomeScreen(); delay(200); return; }
      }

      int clickedSlot = -1;
      if (y >= 54 && y <= 129) {
        if (x >= 15 && x <= 100) clickedSlot = 0; else if (x >= 117 && x <= 202) clickedSlot = 1; else if (x >= 220 && x <= 305) clickedSlot = 2;
      } else if (y >= 142 && y <= 217) {
        if (x >= 15 && x <= 100) clickedSlot = 3; else if (x >= 117 && x <= 202) clickedSlot = 4; else if (x >= 220 && x <= 305) clickedSlot = 5;
      }

      if (clickedSlot != -1) {
        int layoutIdx = (homePage * 6) + clickedSlot;
        launchAppById(homeLayout[layoutIdx]);
        delay(200);
      }
    }
    else if (currentMode == 1) { // Calc
      if (y >= 56 && y <= 232) {
        int col = (x - 12) / 75, row = (y - 56) / 44;
        if (col >= 0 && col < 4 && row >= 0 && row < 4) {
          char keys[4][4] = {{'7','8','9','/'},{'4','5','6','*'},{'1','2','3','-'},{'C','0','=','+'}};
          char pressed = keys[row][col];
          if (pressed >= '0' && pressed <= '9') { if (calcInput == "0") calcInput = ""; calcInput += pressed; updateCalcDisplay(calcInput); }
          else if (pressed == 'C') { calcInput = ""; num1 = 0; num2 = 0; op = ' '; updateCalcDisplay("0"); }
          else if (pressed == '=') { if (op != ' ' && calcInput.length() > 0) calculateResult(); }
          else { if (calcInput.length() > 0) { num1 = calcInput.toFloat(); op = pressed; calcInput = ""; updateCalcDisplay(String(num1) + " " + op); } }
          delay(200);
        }
      }
    }
    else if (currentMode == 2) { // Timer & Stopwatch
      if (y >= 6 && y <= 34) {
        if (x >= 52 && x <= 152) { timerSubTab = 0; drawTimerUI(); delay(150); return; }
        else if (x >= 158 && x <= 258) { timerSubTab = 1; drawTimerUI(); delay(150); return; }
      }
      if (timerSubTab == 0) {
        if (y >= 95 && y <= 129) {
          int col = (x - 12) / 75, p1[4] = {1, 5, 10, 15};
          if (col >= 0 && col < 3) { timerRunning = false; initialTimerSeconds = p1[col] * 60; totalSeconds = initialTimerSeconds; drawTimerUI(); delay(200); }
          else if (col == 3) { if (totalSeconds >= 60) { totalSeconds -= 60; initialTimerSeconds = totalSeconds; } renderTimerText(); delay(200); }
        } else if (y >= 135 && y <= 169) {
          int col = (x - 12) / 75, p2[3] = {25, 30, 60};
          if (col >= 0 && col < 3) { timerRunning = false; initialTimerSeconds = p2[col] * 60; totalSeconds = initialTimerSeconds; drawTimerUI(); delay(200); }
          else if (col == 3) { totalSeconds += 60; initialTimerSeconds = totalSeconds; renderTimerText(); delay(200); }
        } else if (x >= 20 && x <= 150 && y >= 180 && y <= 228) { timerRunning = !timerRunning; drawTimerUI(); delay(250); }
        else if (x >= 170 && x <= 300 && y >= 180 && y <= 228) { timerRunning = false; totalSeconds = 25 * 60; initialTimerSeconds = totalSeconds; drawTimerUI(); delay(250); }
      } else {
        if (y >= 180 && y <= 228) {
          if (x >= 15 && x <= 105) {
