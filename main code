// --- TIMER & STOPWATCH APP ---
void renderTimerText() {
  if (currentMode != 2) return;
  if (timerSubTab == 0) {
    int minutes = totalSeconds / 60, seconds = totalSeconds % 60;
    String timeStr = (minutes < 10 ? "0" : "") + String(minutes) + ":" + (seconds < 10 ? "0" : "") + String(seconds);
    drawModernButton(20, 45, 280, 42, COLOR_CARD_BG, timeStr, COLOR_TEXT, 3);
  } else {
    unsigned long msec = swElapsed % 1000 / 10;
    unsigned long sec = (swElapsed / 1000) % 60;
    unsigned long min = (swElapsed / 60000);
    String swStr = (min < 10 ? "0" : "") + String(min) + ":" + (sec < 10 ? "0" : "") + String(sec) + "." + (msec < 10 ? "0" : "") + String(msec);
    drawModernButton(20, 45, 280, 42, COLOR_CARD_BG, swStr, COLOR_TEXT, 3);
  }
}

