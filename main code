void drawModernButton(int x, int y, int w, int h, uint16_t bgColor, String text, uint16_t textColor = COLOR_TEXT, int textSize = 2) {
  gfx->fillRoundRect(x, y, w, h, 6, bgColor);
  gfx->drawRoundRect(x, y, w, h, 6, COLOR_TEXT_DIM);
  int textX = x + (w - (text.length() * 6 * textSize)) / 2;
  int textY = y + (h - (8 * textSize)) / 2;
  if (textX < x + 2) textX = x + 4;
  gfx->setCursor(textX, textY);
  gfx->setTextColor(textColor);
  gfx->setTextSize(textSize);
  gfx->print(text);
}

