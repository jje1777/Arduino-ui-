void resetTTTGame() {
  for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++) tttBoard[r][c] = ' ';
  tttGameOver = false; tttStatus = "YOUR TURN (X)";
}

bool checkTTTWinner(char p) {
  for (int i = 0; i < 3; i++) {
    if (tttBoard[i][0] == p && tttBoard[i][1] == p && tttBoard[i][2] == p) return true;
    if (tttBoard[0][i] == p && tttBoard[1][i] == p && tttBoard[2][i] == p) return true;
  }
  if (tttBoard[0][0] == p && tttBoard[1][1] == p && tttBoard[2][2] == p) return true;
  if (tttBoard[0][2] == p && tttBoard[1][1] == p && tttBoard[2][0] == p) return true;
  return false;
}

bool isTTTFull() {
  for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++) if (tttBoard[r][c] == ' ') return false;
  return true;
}

void tttAIMove() {
  if (tttGameOver) return;
  for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++) { if (tttBoard[r][c] == ' ') { tttBoard[r][c] = 'O'; if (checkTTTWinner('O')) return; tttBoard[r][c] = ' '; } }
  for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++) { if (tttBoard[r][c] == ' ') { tttBoard[r][c] = 'X'; if (checkTTTWinner('X')) { tttBoard[r][c] = 'O'; return; } tttBoard[r][c] = ' '; } }
  if (tttBoard[1][1] == ' ') { tttBoard[1][1] = 'O'; return; }
  for (int r = 0; r < 3; r++) for (int c = 0; c < 3; c++) if (tttBoard[r][c] == ' ') { tttBoard[r][c] = 'O'; return; }
}

