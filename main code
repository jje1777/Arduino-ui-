void applyTheme(int themeIdx) {
  currentTheme = themeIdx;
  switch (currentTheme) {
    case 0: COLOR_BG=0x10A2; COLOR_CARD_BG=0x2128; COLOR_TEXT=0xFFFF; COLOR_TEXT_DIM=0x9492; COLOR_ACCENT=0x3B1F; COLOR_GREEN=0x2E6B; COLOR_RED=0xE208; COLOR_ORANGE=0xFCE0; break;
    case 1: COLOR_BG=0xE71C; COLOR_CARD_BG=0xFFFF; COLOR_TEXT=0x10A2; COLOR_TEXT_DIM=0x6B5D; COLOR_ACCENT=0x347D; COLOR_GREEN=0x2EC8; COLOR_RED=0xE208; COLOR_ORANGE=0xFD20; break;
    case 2: COLOR_BG=0x2800; COLOR_CARD_BG=0x5800; COLOR_TEXT=0xFFFF; COLOR_TEXT_DIM=0xF3E0; COLOR_ACCENT=0x9000; COLOR_GREEN=0x2EC8; COLOR_RED=0xF800; COLOR_ORANGE=0xFD20; break;
    case 3: COLOR_BG=0x3180; COLOR_CARD_BG=0x6300; COLOR_TEXT=0xFFFF; COLOR_TEXT_DIM=0xFC00; COLOR_ACCENT=0xAC00; COLOR_GREEN=0x2EC8; COLOR_RED=0xE208; COLOR_ORANGE=0xFCE0; break;
    case 4: COLOR_BG=0x01A0; COLOR_CARD_BG=0x0380; COLOR_TEXT=0xFFFF; COLOR_TEXT_DIM=0x87E0; COLOR_ACCENT=0x05A0; COLOR_GREEN=0x07E0; COLOR_RED=0xE208; COLOR_ORANGE=0xFD20; break;
    case 5: COLOR_BG=0x180B; COLOR_CARD_BG=0x3813; COLOR_TEXT=0xFFFF; COLOR_TEXT_DIM=0xC3F7; COLOR_ACCENT=0x601B; COLOR_GREEN=0x2EC8; COLOR_RED=0xE208; COLOR_ORANGE=0xFD20; break;
  }
  if (EEPROM.read(EEPROM_THEME_ADDR) != currentTheme) {
    EEPROM.write(EEPROM_THEME_ADDR, currentTheme);
  }
}

void playTone(int freq = 1000, int duration = 50) {
  if (currentMode != 3 && currentMode != 26 && systemVolume > 0) {
    int scaledDuration = (duration * systemVolume) / 100;
    buzzer.tone(freq, scaledDuration > 5 ? scaledDuration : 5);
  }
}

void triggerWrongPasswordBuzzer() { playTone(250, 400); }

